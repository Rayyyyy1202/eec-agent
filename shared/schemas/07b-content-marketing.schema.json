{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eec/07b-content-marketing",
  "title": "eec-07b-content-marketing output",
  "type": "object",
  "required": ["keyword_clusters", "content_calendar", "drafts", "internal_link_map", "editorial_voice_ref", "meta"],
  "properties": {
    "keyword_clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "head_keyword", "search_intent"],
        "properties": {
          "id": { "type": "string", "pattern": "^cluster_[0-9]{3}$" },
          "topic": { "type": "string" },
          "head_keyword": { "type": "string" },
          "long_tails": { "type": "array", "items": { "type": "string" } },
          "search_intent": { "type": "string", "enum": ["informational", "commercial", "transactional", "navigational"] },
          "audience_id": { "type": "string", "pattern": "^audience_[0-9]{3}$" },
          "linked_sku_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "content_calendar": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scheduled_date", "content_type", "title", "target_keyword", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^content_[0-9]{3}$" },
          "scheduled_date": { "type": "string", "format": "date" },
          "content_type": {
            "type": "string",
            "enum": ["blog", "landing", "video", "social", "email_newsletter", "comparison", "guide", "ugc_repost"]
          },
          "title": { "type": "string" },
          "target_keyword": { "type": "string" },
          "cluster_id": { "type": "string", "pattern": "^cluster_[0-9]{3}$" },
          "owner": { "type": "string" },
          "status": { "type": "string", "enum": ["planned", "drafted", "reviewed", "published"] },
          "route_path": {
            "type": "string",
            "pattern": "^/(blog|guides|videos|news)/[a-z0-9-]+$",
            "description": "Site-relative route this calendar entry maps to. Required when content_type produces an indexable page (blog/guide/comparison/landing). Convention: /blog/<slug> for blog/comparison, /guides/<slug> for guide, /videos/<slug> for video."
          }
        }
      }
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content_id", "title", "outline", "target_keyword", "slug"],
        "properties": {
          "id": { "type": "string", "pattern": "^draft_[0-9]{3}$" },
          "content_id": { "type": "string", "pattern": "^content_[0-9]{3}$" },
          "title": { "type": "string" },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "maxLength": 100,
            "description": "URL slug for the post (no leading slash). 05 mounts at <route_path>/<slug>."
          },
          "hero_asset_id": {
            "type": "string",
            "description": "ref into eec/04-creative-factory/output.json#/assets[]; if absent 05 falls back to gradient placeholder"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 280,
            "description": "Plain-text summary for /blog index card + meta description fallback"
          },
          "outline": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["h", "text"],
              "properties": {
                "h": { "type": "integer", "minimum": 1, "maximum": 4 },
                "text": { "type": "string" }
              }
            }
          },
          "body_md_path": { "type": "string" },
          "target_keyword": { "type": "string" },
          "secondary_keywords": { "type": "array", "items": { "type": "string" } },
          "internal_links": { "type": "array", "items": { "type": "string" } },
          "cta_sku_id": { "type": "string" },
          "language": { "$ref": "_common#/$defs/LanguageCode" },
          "estimated_reading_time_min": { "type": "integer" }
        }
      }
    },
    "internal_link_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "anchor"],
        "properties": {
          "source": { "type": "string", "description": "Source route or content_id" },
          "target": { "type": "string", "description": "Target route or content_id" },
          "anchor": { "type": "string" }
        }
      }
    },
    "distribution_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content_id", "channel", "scheduled_date"],
        "properties": {
          "content_id": { "type": "string" },
          "channel": { "type": "string", "enum": ["email", "social_organic", "newsletter", "syndication", "outreach", "paid_amplification"] },
          "scheduled_date": { "type": "string", "format": "date" }
        }
      }
    },
    "editorial_voice_ref": {
      "type": "string",
      "description": "Path to brand-identity tone — e.g. ./eec/03-brand-identity/output.json#/tone — DO NOT duplicate, only reference"
    },
    "meta": { "$ref": "_common#/$defs/Meta" }
  }
}

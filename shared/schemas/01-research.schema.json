{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eec/01-research",
  "title": "eec-01-research output",
  "type": "object",
  "required": ["niche", "trends", "demand", "pain_points", "competitors", "audience_profiles", "ad_intelligence", "supply_signals", "meta"],
  "properties": {
    "niche": {
      "type": "object",
      "required": ["primary_keyword", "region", "language"],
      "properties": {
        "primary_keyword": { "type": "string" },
        "related_keywords": { "type": "array", "items": { "type": "string" } },
        "region": { "type": "string", "description": "Target market, e.g. 'North America', 'EU', 'JP'" },
        "language": { "$ref": "_common#/$defs/LanguageCode" }
      }
    },
    "trends": {
      "type": "object",
      "required": ["direction_12mo", "seasonality", "claim_meta"],
      "properties": {
        "direction_12mo": { "type": "string", "enum": ["rising", "stable", "declining"] },
        "trajectory_5yr": { "type": "string" },
        "seasonality": {
          "type": "object",
          "required": ["has_seasonality"],
          "properties": {
            "has_seasonality": { "type": "boolean" },
            "peak_months": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
            "trough_months": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } }
          }
        },
        "claim_meta": { "$ref": "_common#/$defs/SourcedClaim" }
      }
    },
    "demand": {
      "type": "object",
      "required": ["volume_band", "claim_meta"],
      "properties": {
        "volume_band": { "type": "string", "enum": ["very_low", "low", "medium", "high", "very_high"] },
        "monthly_search_estimate": { "type": "integer" },
        "rising_queries": { "type": "array", "items": { "type": "string" } },
        "related_queries": { "type": "array", "items": { "type": "string" } },
        "claim_meta": { "$ref": "_common#/$defs/SourcedClaim" }
      }
    },
    "pain_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "summary", "frequency", "claim_meta"],
        "properties": {
          "id": { "type": "string", "pattern": "^pain_[0-9]{3}$" },
          "summary": { "type": "string" },
          "verbatim_quotes": { "type": "array", "items": { "type": "string" } },
          "frequency": { "type": "string", "enum": ["rare", "common", "dominant"] },
          "segment": { "type": "string", "description": "Which audience segment expresses this" },
          "claim_meta": { "$ref": "_common#/$defs/SourcedClaim" }
        }
      }
    },
    "competitors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "brand", "url", "key_angle", "claim_meta"],
        "properties": {
          "id": { "type": "string", "pattern": "^comp_[0-9]{3}$" },
          "brand": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "est_traffic_band": { "type": "string", "enum": ["niche", "small", "medium", "large", "leader"] },
          "key_angle": { "type": "string" },
          "price_band": { "type": "string", "enum": ["budget", "mid", "premium", "luxury"] },
          "ad_creatives_observed_count": { "type": "integer", "minimum": 0 },
          "weakness_observed": { "type": "string" },
          "claim_meta": { "$ref": "_common#/$defs/SourcedClaim" }
        }
      }
    },
    "audience_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_common#/$defs/AudienceProfile" }
    },
    "ad_intelligence": {
      "type": "object",
      "properties": {
        "top_creatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "url_or_id", "hook"],
            "properties": {
              "platform": { "type": "string", "enum": ["meta", "tiktok", "google", "youtube", "pinterest", "x"] },
              "url_or_id": { "type": "string" },
              "hook": { "type": "string" },
              "format": { "type": "string" },
              "observed_runtime_days": { "type": "integer" }
            }
          }
        },
        "common_hooks": { "type": "array", "items": { "type": "string" } },
        "avg_cpm_band": { "type": "string", "enum": ["low", "mid", "high", "very_high", "unknown"] }
      }
    },
    "supply_signals": {
      "type": "object",
      "description": "Surface-level supply signals only — deep cost/lead-time analysis happens in eec-02-product-selection",
      "properties": {
        "aliexpress_avg_cost": { "$ref": "_common#/$defs/Money" },
        "alibaba_avg_cost": { "$ref": "_common#/$defs/Money" },
        "lead_time_days_band": { "type": "string", "enum": ["under_7", "7_14", "14_30", "30_60", "over_60"] },
        "claim_meta": { "$ref": "_common#/$defs/SourcedClaim" }
      }
    },
    "meta": { "$ref": "_common#/$defs/Meta" }
  }
}

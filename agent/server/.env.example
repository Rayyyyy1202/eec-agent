# ─── Core (required for skill execution) ─────────────────────────────────
# OpenAI-compatible LLM endpoint. Required for /skills/:id/run + chat.
OPENAI_API_KEY=sk-...

# Optional override. Defaults: gpt-4o (chat) / gpt-image-1 (creative-factory).
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Server location ─────────────────────────────────────────────────────
# All optional — sensible defaults derived from this repo's location.
# REPO_ROOT must be an ancestor of any brand workspace; brand creation
# rejects paths outside REPO_ROOT.
# REPO_ROOT=/absolute/path/to/eec_skills
# WORKSPACE_PATH=/absolute/path/to/eec_skills/workspace
# AGENT_DB_PATH=/absolute/path/to/eec_skills/agent/server/data/eec.sqlite
# PORT=3001

# ─── Skill 06 — Tracking ─────────────────────────────────────────────────
# GTM_CONTAINER_ID=GTM-XXXXXXX
# GA4_PROPERTY_ID=
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Skill 07a — Tech SEO ────────────────────────────────────────────────
# GSC_PROPERTY_URL=https://example.com/
# GSC_OAUTH_CREDENTIALS=/path/to/service-account.json

# ─── Skill 08 — Paid ads ─────────────────────────────────────────────────
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_xxxxxxxx
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# TIKTOK_ACCESS_TOKEN=

# ─── Skill 05/05b — Storefront ───────────────────────────────────────────
# SHOPIFY_SHOP=my-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# STRIPE_SECRET_KEY=sk_test_...

# ─── Phase 2: Email / CRM ────────────────────────────────────────────────
# SENDGRID_API_KEY=
# RESEND_API_KEY=
# KLAVIYO_API_KEY=
